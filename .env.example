# Copy to .env and fill in once a sales-dashboard data endpoint exists.
# Until then, leave DATA_SOURCE=local (or VITE_PRODUCT_DATA_URL empty) and the dashboard keeps
# using data/latest.json exactly as it does today.

# local | remote
DATA_SOURCE=local

# JSON endpoint that returns { meta, categories, styles, launch, summary } (see data/latest.json
# for the current local shape). Required when DATA_SOURCE=remote.
VITE_PRODUCT_DATA_URL=

# Abort the remote fetch after this many milliseconds and fall back to local data.
VITE_PRODUCT_DATA_TIMEOUT_MS=8000

# false for local editing, true for production/shared read-only publishing.
REORDER_READ_ONLY=false
