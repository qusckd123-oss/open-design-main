<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>26SS 판매추이 대시보드</title>
<style>
:root{color-scheme:light;--bg:#f5f7fb;--panel:#ffffff;--surface:#ffffff;--line:#dfe4ee;--line2:#edf0f6;--text:#18202f;--muted:#6f7a8c;--soft:#2d3648;--accent:#3b6eea;--accent2:#315fd0;--green:#059669;--red:#dc2626;--amber:#d97706}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:"Inter Variable","SF Pro Display",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-feature-settings:"cv01","ss03";letter-spacing:0}button,input,select{font:inherit}
.app{display:grid;grid-template-columns:288px 1fr;min-height:100vh}aside{position:sticky;top:0;height:100vh;background:var(--panel);border-right:1px solid var(--line);padding:20px;overflow:auto;box-shadow:10px 0 30px rgba(31,41,55,.04)}main{padding:24px 28px 40px;min-width:0}
.brand{display:flex;align-items:center;gap:10px;margin-bottom:24px}.mark{width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,var(--accent),#14b8a6);box-shadow:0 8px 24px rgba(59,110,234,.22)}h1{font-size:26px;line-height:1.12;font-weight:510;margin:0}.sub{font-size:12px;color:var(--muted);margin-top:3px}
.filter{margin:16px 0}.filter label{display:block;font-size:11px;color:var(--muted);margin:0 0 7px}.control{width:100%;height:34px;background:#f8fafc;border:1px solid var(--line);border-radius:6px;color:var(--soft);padding:0 10px;outline:none}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px;background:#f4f6fa;border:1px solid var(--line);border-radius:8px}.seg button{height:28px;border:0;border-radius:5px;background:transparent;color:var(--muted);cursor:pointer}.seg button.active{background:var(--accent2);color:white}
.grid{display:grid;gap:14px}.kpis{grid-template-columns:repeat(5,minmax(0,1fr));margin-bottom:14px}.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;min-width:0;box-shadow:0 10px 28px rgba(31,41,55,.06)}.kpi{padding:15px}.kpi .label{font-size:11px;color:var(--muted)}.kpi .value{font-size:24px;font-weight:510;margin-top:8px}.kpi .delta{font-size:12px;margin-top:6px;color:var(--muted)}
.gender-card{margin-bottom:14px}.gender-body{padding:14px 16px;display:grid;grid-template-columns:minmax(260px,.8fr) 1.2fr;gap:16px;align-items:center}.sharebar{height:16px;border-radius:999px;overflow:hidden;background:#eef2f8;border:1px solid var(--line);display:flex}.sharebar span{display:block;height:100%}.share-uni{background:#315fd0}.share-women{background:#14b8a6}.share-metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.share-metric{padding:10px 12px;border:1px solid var(--line2);border-radius:8px;background:#f8fafc}.share-metric .name{font-size:12px;color:var(--muted)}.share-metric .num{font-size:20px;font-weight:650;margin-top:4px}.share-metric .subnum{font-size:12px;color:var(--muted);margin-top:2px}
.up{color:var(--green)!important}.down{color:var(--red)!important}.flat{color:var(--muted)!important}.layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(320px,.75fr);gap:14px}.panel-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line2)}.panel-title{font-size:14px;font-weight:510;color:var(--soft)}.hint{font-size:11px;color:var(--muted)}
canvas{display:block;width:100%;height:330px}#mixChart{height:220px}.table-wrap{overflow:auto;max-height:520px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:9px 10px;border-bottom:1px solid var(--line2);white-space:nowrap;text-align:right}th{position:sticky;top:0;background:#f3f6fb;color:var(--muted);font-weight:510;z-index:1}td:first-child,th:first-child,td:nth-child(2),th:nth-child(2),td:nth-child(3),th:nth-child(3),td:nth-child(4),th:nth-child(4){text-align:left}tr{cursor:pointer}tr:hover{background:#f8fbff}tr.selected{background:#e9efff}
.thumb{width:52px;height:64px;display:block;object-fit:contain;border:1px solid var(--line);border-radius:6px;background:#fff}.thumb-empty{display:grid;place-items:center;color:var(--muted);font-size:11px;background:#f8fafc}
.pill{display:inline-flex;align-items:center;height:21px;padding:0 8px;border:1px solid var(--line);border-radius:999px;color:var(--soft);background:#f8fafc;font-size:11px}.split{display:grid;grid-template-columns:1.05fr .95fr;gap:14px;margin-top:14px}.wide{grid-column:1/-1}.note{margin-top:14px;padding:12px 14px;color:var(--muted);font-size:12px;line-height:1.55}.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.ghost{height:30px;padding:0 10px;background:#f8fafc;border:1px solid var(--line);border-radius:6px;color:var(--soft);cursor:pointer}.ghost:hover{background:#eef4ff}
@media (max-width:1100px){.app{grid-template-columns:1fr}aside{position:relative;height:auto}.kpis{grid-template-columns:repeat(2,1fr)}.layout,.split,.gender-body{grid-template-columns:1fr}main{padding:18px}}
</style>
</head>
<body>
<div class="app">
<aside>
  <div class="brand"><div class="mark"></div><div><h1>26SS 판매추이</h1><div class="sub" id="sourceLabel"></div></div></div>
  <div class="filter"><label>검색</label><input id="search" class="control" placeholder="스타일, 품번, 품명 검색"></div>
  <div class="filter"><label>카테고리</label><select id="category" class="control"></select></div>
  <div class="filter"><label>아이템</label><select id="item" class="control"></select></div>
  <div class="filter"><label>메인/스팟</label><select id="mainSpot" class="control"></select></div>
  <div class="filter"><label>채널</label><div class="seg" id="channelSeg"><button data-v="total" class="active">전체</button><button data-v="on">ON</button><button data-v="off">OFF</button></div></div>
  <div class="filter"><label>지표</label><div class="seg" id="metricSeg"><button data-v="sales" class="active">실판가</button><button data-v="qty">수량</button><button data-v="rate">판매율</button></div></div>
  <div class="filter"><label>정렬</label><select id="sort" class="control"><option value="weekSales">최근주 실판가</option><option value="cumSales">누계 실판가</option><option value="weekQty">최근주 수량</option><option value="sellRate">판매율</option><option value="wow">전주대비</option></select></div>
  <button class="ghost" id="reset">초기화</button>
</aside>
<main>
  <section class="grid kpis">
    <div class="card kpi"><div class="label">최근주 실판가</div><div class="value" id="kWeekSales"></div><div class="delta" id="kWow"></div></div>
    <div class="card kpi"><div class="label">전년 동주 실판가</div><div class="value" id="kPriorSales"></div><div class="delta" id="kYoY"></div></div>
    <div class="card kpi"><div class="label">누계 실판가</div><div class="value" id="kCumSales"></div><div class="delta" id="kCumYoY"></div></div>
    <div class="card kpi"><div class="label">최근주 판매수량</div><div class="value" id="kWeekQty"></div><div class="delta" id="kStyleCount"></div></div>
    <div class="card kpi"><div class="label">판매율</div><div class="value" id="kRate"></div><div class="delta" id="kSkuCount"></div></div>
  </section>
  <section class="card gender-card">
    <div class="panel-head"><div><div class="panel-title">유니 / 우먼스 주간매출비중</div><div class="hint" id="genderShareHint">APP 기준 주간 실판가</div></div></div>
    <div class="gender-body">
      <div>
        <div class="sharebar"><span class="share-uni" id="genderUniBar"></span><span class="share-women" id="genderWomenBar"></span></div>
        <div class="share-metrics">
          <div class="share-metric"><div class="name">유니섹스</div><div class="num" id="genderUniPct"></div><div class="subnum" id="genderUniSales"></div></div>
          <div class="share-metric"><div class="name">우먼스</div><div class="num" id="genderWomenPct"></div><div class="subnum" id="genderWomenSales"></div></div>
        </div>
      </div>
      <div class="table-wrap"><table id="genderShareTable"></table></div>
    </div>
  </section>
  <section class="layout">
    <div class="card"><div class="panel-head"><div><div class="panel-title">주차별 판매추이</div><div class="hint" id="chartHint"></div></div><div class="toolbar"><button class="ghost" id="clearPick">선택 해제</button></div></div><canvas id="trendChart"></canvas></div>
    <div class="card"><div class="panel-head"><div class="panel-title">아이템 구성</div><div class="hint">최근주 기준</div></div><canvas id="mixChart"></canvas></div>
  </section>
  <section class="split">
    <div class="card"><div class="panel-head"><div class="panel-title">26SS 주간 스타일 랭킹</div><div class="hint" id="rankHint"></div></div><div class="table-wrap"><table id="styleTable"></table></div></div>
    <div class="card"><div class="panel-head"><div class="panel-title">25SS 동기간 주간 스타일 랭킹</div><div class="hint" id="priorRankHint"></div></div><div class="table-wrap"><table id="priorStyleTable"></table></div></div>
    <div class="card"><div class="panel-head"><div class="panel-title">아이템별 데이터</div><div class="hint">현재 필터 기준</div></div><div class="table-wrap"><table id="itemDataTable"></table></div></div>
    <div class="card"><div class="panel-head"><div class="panel-title">아이템 전년비</div><div class="hint">26SS vs 25SS 동일 주차 순번</div></div><div class="table-wrap"><table id="itemTable"></table></div></div>
  </section>
  <div class="card note">데이터 기준: 26SS는 <span id="note26"></span>, 전년비는 25SS <span id="note25"></span>와 같은 주차 순번으로 비교했습니다. 누계는 엑셀의 별도 누계 컬럼이 아니라 현재 필터에 포함된 스타일/SKU의 주차별 판매 데이터를 합산해 계산합니다.</div>
</main>
</div>
