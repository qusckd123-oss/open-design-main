<script>
const DATA = JSON.parse(document.getElementById('payload').textContent);
const $ = id => document.getElementById(id);
let state = {channel:'total', metric:'sales', selected:null};
const fmtWon = v => v>=100000000 ? (v/100000000).toFixed(2)+'억' : v>=10000 ? Math.round(v/10000).toLocaleString()+'만' : Math.round(v).toLocaleString();
const fmtQty = v => Math.round(v).toLocaleString();
const fmtPct = v => ((v||0)*100).toFixed(1)+'%';
const fmtDelta = v => Number.isFinite(v) ? `${v>=0?'+':''}${(v*100).toFixed(1)}%` : '-';
const clsDelta = v => !Number.isFinite(v)||v===0 ? 'flat' : v>0 ? 'up' : 'down';
const styleThumb = style => DATA.imageMap && DATA.imageMap[style] ? `<img class="thumb" src="${DATA.imageMap[style]}" alt="${style}">` : '<div class="thumb thumb-empty">-</div>';
const sum = arr => arr.reduce((a,b)=>a+(+b||0),0);
const by = (arr, key) => [...new Set(arr.map(r=>r[key]).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'ko'));
const arrKey = (channel, metric) => `${channel}${metric==='qty'?'Qty':'Sales'}`;
function fillSelect(id, vals, label='전체'){ $(id).innerHTML = `<option value="">${label}</option>` + vals.map(v=>`<option>${v}</option>`).join(''); }
fillSelect('category', by(DATA.records,'category')); fillSelect('item', by(DATA.records,'item')); fillSelect('mainSpot', by(DATA.records,'mainSpot'));
$('sourceLabel').textContent = `${DATA.source} · ${DATA.updatedThrough} 기준`;
$('note26').textContent = `${DATA.source} ${DATA.updatedThrough}`;
$('note25').textContent = `${DATA.priorSource} ${DATA.priorCompareWeek}`;
function currentFilters(){return {q:$('search').value.trim().toLowerCase(), c:$('category').value, it:$('item').value, ms:$('mainSpot').value};}
function filterRows(sourceRows, includeSearch=true, opts={}){
  const f=currentFilters();
  return sourceRows.filter(r=>(opts.ignoreCategory||!f.c||r.category===f.c)&&(!f.it||r.item===f.it)&&(!f.ms||r.mainSpot===f.ms)&&(!includeSearch||!f.q||[r.style,r.sku,r.name,r.item].join(' ').toLowerCase().includes(f.q)));
}
function seriesFor(rows, channel=state.channel, metric=state.metric){
  return DATA.weeks.map((_,i)=>{
    if(metric==='rate'){
      const cumQty = sum(rows.map(r=>(r[`${channel}Qty`]||[]).slice(0,i+1).reduce((a,b)=>a+b,0)));
      const inQty = sum(rows.map(r=>r.inQty));
      return inQty ? cumQty / inQty : 0;
    }
    const key = arrKey(channel, metric);
    return sum(rows.map(r=>(r[key]||[])[i]||0));
  });
}
function lastVal(rows, metric=state.metric){ const s=seriesFor(rows, state.channel, metric); return s[s.length-1]||0; }
function valueAt(rows, channel=state.channel, metric='sales', index=DATA.weeks.length-1){
  const key = `${channel}${metric==='qty'?'Qty':'Sales'}`;
  return sum(rows.map(r=>(r[key]||[])[index]||0));
}
function periodTotal(rows, channel=state.channel, metric='sales', endIndex=DATA.weeks.length-1){
  const key = `${channel}${metric==='qty'?'Qty':'Sales'}`;
  return sum(rows.map(r=>sum((r[key]||[]).slice(0, endIndex+1))));
}
function samePeriodTotal(rows, metric='sales', endIndex=DATA.weeks.length-1){
  return periodTotal(rows, state.channel, metric, endIndex);
}
function yoy(cur, prior){ return prior ? cur / prior - 1 : NaN; }
function aggregate(rows, key, weekIndex=DATA.weeks.length-1, periodEndIndex=weekIndex){
  const m = new Map();
  rows.forEach(r=>{ const k=r[key]||'미분류'; if(!m.has(k)) m.set(k, []); m.get(k).push(r); });
  return [...m].map(([k,rs])=>{
    const cumSales = periodTotal(rs, state.channel, 'sales', periodEndIndex);
    const cumQty = periodTotal(rs, state.channel, 'qty', periodEndIndex);
    const inQty = sum(rs.map(r=>r.inQty));
    return {key:k, rows:rs, weekSales:valueAt(rs,state.channel,'sales',weekIndex), weekQty:valueAt(rs,state.channel,'qty',weekIndex), cumSales, cumQty, inQty, sellRate:inQty ? cumQty / inQty : 0};
  });
}
function genderShare(rows, weekIndex=DATA.weeks.length-1){
  const appRows = rows.filter(r=>r.category==='유니섹스' || r.category==='우먼스');
  const uniRows = appRows.filter(r=>r.category==='유니섹스');
  const womenRows = appRows.filter(r=>r.category==='우먼스');
  const uniSales = valueAt(uniRows,state.channel,'sales',weekIndex);
  const womenSales = valueAt(womenRows,state.channel,'sales',weekIndex);
  const uniQty = valueAt(uniRows,state.channel,'qty',weekIndex);
  const womenQty = valueAt(womenRows,state.channel,'qty',weekIndex);
  const totalSales = uniSales + womenSales;
  return {
    uniSales, womenSales, uniQty, womenQty, totalSales,
    uniPct: totalSales ? uniSales / totalSales : 0,
    womenPct: totalSales ? womenSales / totalSales : 0
  };
}
function drawLine(canvas, labels, main, picked=null){
  const ctx=canvas.getContext('2d'), dpr=devicePixelRatio||1, w=canvas.clientWidth*dpr, h=canvas.clientHeight*dpr; canvas.width=w; canvas.height=h; ctx.clearRect(0,0,w,h);
  const pad={l:58*dpr,r:20*dpr,t:24*dpr,b:46*dpr}, vals=[...main, ...(picked||[])], max=Math.max(...vals,1), min=0;
  ctx.strokeStyle='#e5eaf2'; ctx.lineWidth=1*dpr; ctx.font=`${11*dpr}px sans-serif`;
  for(let g=0;g<=4;g++){ const y=pad.t+(h-pad.t-pad.b)*g/4; ctx.beginPath(); ctx.moveTo(pad.l,y); ctx.lineTo(w-pad.r,y); ctx.stroke(); }
  const x=i=>pad.l+(w-pad.l-pad.r)*(i/(labels.length-1||1)); const y=v=>h-pad.b-(h-pad.t-pad.b)*((v-min)/(max-min||1));
  function path(vals, color, width){ ctx.strokeStyle=color; ctx.lineWidth=width*dpr; ctx.beginPath(); vals.forEach((v,i)=>{ const xx=x(i), yy=y(v); i?ctx.lineTo(xx,yy):ctx.moveTo(xx,yy); }); ctx.stroke(); vals.forEach((v,i)=>{ctx.fillStyle=color;ctx.beginPath();ctx.arc(x(i),y(v),2.2*dpr,0,Math.PI*2);ctx.fill();}); }
  if(picked) path(picked,'#059669',2); path(main,'#3b6eea',2.5);
  labels.forEach((lab,i)=>{ if(i%2===0 || i===labels.length-1){ ctx.save(); ctx.translate(x(i),h-22*dpr); ctx.rotate(-.55); ctx.fillStyle='#6f7a8c'; ctx.fillText(lab,0,0); ctx.restore(); }});
  [max,max*.75,max*.5,max*.25,0].forEach((v,i)=>{ctx.fillStyle='#6f7a8c'; ctx.fillText(state.metric==='rate'?fmtPct(v):state.metric==='qty'?fmtQty(v):fmtWon(v), 6*dpr, pad.t+(h-pad.t-pad.b)*i/4+4*dpr);});
}
function drawBars(canvas, rows){
  const ctx=canvas.getContext('2d'), dpr=devicePixelRatio||1, w=canvas.clientWidth*dpr, h=canvas.clientHeight*dpr; canvas.width=w; canvas.height=h; ctx.clearRect(0,0,w,h);
  const items=aggregate(rows,'item').sort((a,b)=>b.weekSales-a.weekSales).slice(0,8), max=Math.max(...items.map(x=>x.weekSales),1);
  ctx.font=`${12*dpr}px sans-serif`;
  items.forEach((it,i)=>{ const y=22*dpr+i*24*dpr, bw=(w-150*dpr)*(it.weekSales/max); ctx.fillStyle='rgba(59,110,234,.82)'; ctx.fillRect(110*dpr,y,bw,12*dpr); ctx.fillStyle='#2d3648'; ctx.fillText(it.key,12*dpr,y+11*dpr); ctx.fillStyle='#6f7a8c'; ctx.fillText(fmtWon(it.weekSales),118*dpr+bw,y+11*dpr); });
}
function renderTable(id, headers, rows, mapper){ $(id).innerHTML = `<thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map(mapper).join('')}</tbody>`; }
function itemComparison(curRows, priorRows){
  const cur = aggregate(curRows,'item');
  const prior = aggregate(priorRows,'item', DATA.priorCompareIndex, DATA.priorCompareIndex);
  const pm = new Map(prior.map(x=>[x.key,x]));
  return cur.map(x=>{ const p=pm.get(x.key)||{weekSales:0,weekQty:0,cumSales:0,cumQty:0}; x.priorWeekSales=p.weekSales; x.priorWeekQty=p.weekQty; x.priorCumSales=p.cumSales; x.priorCumQty=p.cumQty; x.yoy=yoy(x.weekSales,p.weekSales); x.cumYoy=yoy(x.cumSales,p.cumSales); return x; });
}
function render(){
  const rows=filterRows(DATA.records), priorRows=filterRows(DATA.priorRecords, false), prev=DATA.weeks.length-2;
  const genderRows=filterRows(DATA.records, true, {ignoreCategory:true}), priorGenderRows=filterRows(DATA.priorRecords, false, {ignoreCategory:true});
  const priorIdx=DATA.priorCompareIndex;
  const curSales=lastVal(rows,'sales'), curQty=lastVal(rows,'qty'), priorSales=valueAt(priorRows,state.channel,'sales',priorIdx), trend=seriesFor(rows), prevSales=prev>=0?trend[prev]:0, wow=yoy(curSales,prevSales), yy=yoy(curSales,priorSales);
  const cumSales=periodTotal(rows,state.channel,'sales'), cumQty=periodTotal(rows,state.channel,'qty'), inQty=sum(rows.map(r=>r.inQty)), rate=inQty?cumQty/inQty:0;
  const priorCumSales=samePeriodTotal(priorRows,'sales',priorIdx), cumYoy=yoy(cumSales,priorCumSales);
  $('kWeekSales').textContent=fmtWon(curSales); $('kPriorSales').textContent=fmtWon(priorSales); $('kWeekQty').textContent=fmtQty(curQty); $('kCumSales').textContent=fmtWon(cumSales); $('kRate').textContent=fmtPct(rate);
  $('kWow').textContent=`전주대비 ${fmtDelta(wow)}`; $('kWow').className='delta '+clsDelta(wow);
  $('kYoY').textContent=`전년비 ${fmtDelta(yy)}`; $('kYoY').className='delta '+clsDelta(yy);
  $('kCumYoY').textContent=`전년 동기간 ${fmtDelta(cumYoy)}`; $('kCumYoY').className='delta '+clsDelta(cumYoy);
  $('kStyleCount').textContent=`스타일 ${new Set(rows.map(r=>r.style)).size.toLocaleString()}개`; $('kSkuCount').textContent=`SKU ${rows.length.toLocaleString()}개`;
  const curGender=genderShare(genderRows), priorGender=genderShare(priorGenderRows, priorIdx);
  $('genderUniBar').style.width = `${curGender.uniPct*100}%`;
  $('genderWomenBar').style.width = `${curGender.womenPct*100}%`;
  $('genderUniPct').textContent = fmtPct(curGender.uniPct);
  $('genderWomenPct').textContent = fmtPct(curGender.womenPct);
  $('genderUniSales').textContent = fmtWon(curGender.uniSales);
  $('genderWomenSales').textContent = fmtWon(curGender.womenSales);
  $('genderShareHint').textContent = `${DATA.updatedThrough} APP 주간 실판가 · ${state.channel.toUpperCase()}`;
  renderTable('genderShareTable',['구분','26 주간','26 비중','25 동주','25 비중','전년비'],[
    {label:'유니섹스', sales:curGender.uniSales, pct:curGender.uniPct, priorSales:priorGender.uniSales, priorPct:priorGender.uniPct, yoy:yoy(curGender.uniSales, priorGender.uniSales)},
    {label:'우먼스', sales:curGender.womenSales, pct:curGender.womenPct, priorSales:priorGender.womenSales, priorPct:priorGender.womenPct, yoy:yoy(curGender.womenSales, priorGender.womenSales)}
  ],(r)=>`<tr><td>${r.label}</td><td>${fmtWon(r.sales)}</td><td>${fmtPct(r.pct)}</td><td>${fmtWon(r.priorSales)}</td><td>${fmtPct(r.priorPct)}</td><td class="${clsDelta(r.yoy)}">${fmtDelta(r.yoy)}</td></tr>`);
  const picked = state.selected ? rows.filter(r=>r.style===state.selected) : null;
  drawLine($('trendChart'), DATA.weeks, seriesFor(rows), picked?seriesFor(picked):null); drawBars($('mixChart'), rows);
  $('chartHint').textContent = `${state.channel.toUpperCase()} · ${state.metric==='sales'?'실판가':state.metric==='qty'?'수량':'판매율'} · ${rows.length.toLocaleString()} SKU`;
  const styles=aggregate(rows,'style').map(x=>{ const s=seriesFor(x.rows,'total','sales'); x.wow=s.length>1 && s.at(-2)?s.at(-1)/s.at(-2)-1:0; x.name=x.rows[0].name; x.item=x.rows[0].item; return x; });
  const comp=itemComparison(rows, priorRows);
  const sort=$('sort').value; styles.sort((a,b)=>(Number.isFinite(b[sort])?b[sort]:-999)-(Number.isFinite(a[sort])?a[sort]:-999));
  $('rankHint').textContent=`주간 판매수량/실판가 · 상위 ${Math.min(styles.length,80)}개`;
  renderTable('styleTable',['이미지','스타일','아이템','품명','주간수량','주간실판가','누계','판매율','WoW'],styles.slice(0,80),(r)=>`<tr data-style="${r.key}" class="${state.selected===r.key?'selected':''}"><td>${styleThumb(r.key)}</td><td><span class="pill">${r.key}</span></td><td>${r.item}</td><td>${r.name}</td><td>${fmtQty(r.weekQty)}</td><td>${fmtWon(r.weekSales)}</td><td>${fmtWon(r.cumSales)}</td><td>${fmtPct(r.sellRate)}</td><td class="${clsDelta(r.wow)}">${fmtDelta(r.wow)}</td></tr>`);
  document.querySelectorAll('#styleTable tr[data-style]').forEach(tr=>tr.onclick=()=>{state.selected=tr.dataset.style; render();});
  const priorStyles=aggregate(priorRows,'style',priorIdx,priorIdx).map(x=>{ const cur=valueAt(x.rows,'total','sales',priorIdx), prev=priorIdx>0?valueAt(x.rows,'total','sales',priorIdx-1):0; x.wow=prev?cur/prev-1:0; x.name=x.rows[0].name; x.item=x.rows[0].item; return x; });
  priorStyles.sort((a,b)=>(Number.isFinite(b[sort])?b[sort]:-999)-(Number.isFinite(a[sort])?a[sort]:-999));
  $('priorRankHint').textContent=`주간 판매수량/실판가 · 상위 ${Math.min(priorStyles.length,80)}개`;
  renderTable('priorStyleTable',['스타일','아이템','품명','주간수량','주간실판가','누계','판매율','WoW'],priorStyles.slice(0,80),(r)=>`<tr><td><span class="pill">${r.key}</span></td><td>${r.item}</td><td>${r.name}</td><td>${fmtQty(r.weekQty)}</td><td>${fmtWon(r.weekSales)}</td><td>${fmtWon(r.cumSales)}</td><td>${fmtPct(r.sellRate)}</td><td class="${clsDelta(r.wow)}">${fmtDelta(r.wow)}</td></tr>`);
  const itemData=aggregate(rows,'item').map(x=>{ const s=seriesFor(x.rows,'total','sales'); x.wow=s.length>1 && s.at(-2)?s.at(-1)/s.at(-2)-1:NaN; x.styleCount=new Set(x.rows.map(r=>r.style)).size; x.skuCount=x.rows.length; return x; }).sort((a,b)=>b.weekSales-a.weekSales);
  renderTable('itemDataTable',['아이템','스타일','SKU','최근주','수량','누계','판매율','WoW'],itemData,(r)=>`<tr><td>${r.key}</td><td>${fmtQty(r.styleCount)}</td><td>${fmtQty(r.skuCount)}</td><td>${fmtWon(r.weekSales)}</td><td>${fmtQty(r.weekQty)}</td><td>${fmtWon(r.cumSales)}</td><td>${fmtPct(r.sellRate)}</td><td class="${clsDelta(r.wow)}">${fmtDelta(r.wow)}</td></tr>`);
  comp.sort((a,b)=>b.weekSales-a.weekSales);
  renderTable('itemTable',['아이템','26 최근주','25 동주','전년비','26 누계','25 동기간','누계 전년비'],comp,(r)=>`<tr><td>${r.key}</td><td>${fmtWon(r.weekSales)}</td><td>${fmtWon(r.priorWeekSales)}</td><td class="${clsDelta(r.yoy)}">${fmtDelta(r.yoy)}</td><td>${fmtWon(r.cumSales)}</td><td>${fmtWon(r.priorCumSales)}</td><td class="${clsDelta(r.cumYoy)}">${fmtDelta(r.cumYoy)}</td></tr>`);
}
['search','category','item','mainSpot','sort'].forEach(id=>$(id).addEventListener('input',()=>{state.selected=null;render();}));
document.querySelectorAll('#channelSeg button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#channelSeg button').forEach(x=>x.classList.remove('active'));b.classList.add('active');state.channel=b.dataset.v;render();});
document.querySelectorAll('#metricSeg button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#metricSeg button').forEach(x=>x.classList.remove('active'));b.classList.add('active');state.metric=b.dataset.v;render();});
$('reset').onclick=()=>{['search','category','item','mainSpot'].forEach(id=>$(id).value='');state={channel:'total',metric:'sales',selected:null};document.querySelector('#channelSeg button[data-v=total]').click();document.querySelector('#metricSeg button[data-v=sales]').click();render();};
$('clearPick').onclick=()=>{state.selected=null;render();};
addEventListener('resize',()=>render());
render();
</script>
</body>
</html>