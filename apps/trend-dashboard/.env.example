# Canonical runtime PostgreSQL connection (prisma/schema.prisma).
#   - Production: the future production Neon PostgreSQL database. Never set
#     this to the disposable rehearsal database.
#   - Local development: a separate Neon DEVELOPMENT branch/database - never
#     the production database, and never POSTGRES_VERIFICATION_URL below.
# Placeholder shape only - replace USER/PASSWORD/HOST/DB with your own Neon
# branch's real values; never commit a real value here or in .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Read-only path to the final authoritative SQLite source (prisma/dev.db),
# used ONLY by scripts/export-sqlite-snapshot.ts (via the isolated client
# generated from prisma/schema.sqlite-export.prisma) to produce the fresh
# NDJSON snapshot needed at the Phase 2 production cutover. Not used by the
# app runtime, not used by any collector. Safe to keep as a literal local
# file path - it is not a credential.
SQLITE_EXPORT_DATABASE_URL="file:./dev.db"
# The disposable Neon rehearsal database's own connection string, kept here
# only as a record of which database that rehearsal used. As of the
# 2026-09-17 Phase 2A tooling generalization, scripts/import-postgres-snapshot.ts
# and scripts/reconcile-postgres-snapshot.ts no longer read this variable
# directly - see POSTGRES_MIGRATION_URL below, which both scripts now use
# for EVERY migration target (rehearsal or, later, real production). To
# re-run either script against this same rehearsal database, copy this
# value into POSTGRES_MIGRATION_URL when invoking them. Must remain
# rehearsal-only - never reused as DATABASE_URL, never treated as a
# development or production target.
POSTGRES_VERIFICATION_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# The EXPLICIT migration target for scripts/import-postgres-snapshot.ts,
# scripts/reconcile-postgres-snapshot.ts, AND scripts/migrate-postgres-target.ts
# (`pnpm db:migrate:target`) - the disposable rehearsal database while
# rehearsing, or the real production database at the real cutover.
# Deliberately separate from DATABASE_URL (the app runtime's variable) so
# these tools never accidentally write to whichever database the app
# happens to be configured with - DATABASE_URL is read only for an
# informational same/different report, never as a connection target or a
# gate. Must differ from SQLITE_EXPORT_DATABASE_URL. Never commit a real
# value here or in .env.
# NOTE: a bare `POSTGRES_MIGRATION_URL=... prisma migrate deploy` does NOT
# work - prisma/schema.prisma's datasource reads DATABASE_URL
# unconditionally, so Prisma CLI would migrate whichever database
# DATABASE_URL points to instead. Use `pnpm db:migrate:target`, which spawns
# Prisma CLI with DATABASE_URL set to POSTGRES_MIGRATION_URL in the CHILD
# PROCESS's environment only - see scripts/migrate-postgres-target.ts.
POSTGRES_MIGRATION_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Controls scripts/smoke-test.ts's "corpus-floor" regression guards (checks
# that the REAL historical EditorialPost/MarketRankingSnapshot corpus has
# not shrunk below its historical size) - REQUIRED, never inferred from the
# current row count. Allowed values: "full" (the database is expected to
# already hold the real historical corpus - e.g. the original SQLite
# dev.db, or eventually production; corpus-floor checks hard-fail below
# their floor) or "development" (a fresh/small dev database - e.g. a Neon
# dev/scratch branch seeded only via `pnpm db:seed`; corpus-floor checks
# are explicitly not applicable and are skipped with a logged reason, never
# silently passed). Unset defaults safely to "development". The Neon
# dev/scratch database should use "development" (or leave this unset).
SMOKE_TEST_CORPUS_MODE="development"
DATA_SOURCE="mock"
NAVER_DATA_MODE="mock"
ENABLE_NAVER_TRENDS="false"
ENABLE_INTERNAL_SALES="false"
NAVER_API_KEY_ID=""
NAVER_API_KEY=""
NAVER_API_HUB_CLIENT_ID=""
NAVER_API_HUB_CLIENT_SECRET=""
NAVER_API_HUB_BASE_URL="https://naverapihub.apigw.ntruss.com"
NAVER_SHOPPING_CATEGORY_CODE="50000000"
MUSINSA_USER_AGENT="TrendSignalDashboard/0.1"
MARKET_COLLECTOR_USER_AGENT="TrendSignalDashboard/0.1 (+local market audit)"
