{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wackywilly-trend-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wackywilly-trend-dashboard"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOOK_IMAGES",
      "bucket_name": "look-images"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, never in this file):
  // DASHBOARD_ACCESS_CODE, DATABASE_URL, SESSION_SECRET, R2_ACCOUNT_ID,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_BASE_URL
}
