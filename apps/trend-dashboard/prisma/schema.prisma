// Canonical production/runtime schema - PostgreSQL.
//
// Promoted from the disposable-rehearsal-verified prisma/schema.postgres.prisma
// on 2026-09-17, after a completed SQLite -> disposable Neon rehearsal
// reconciled all 16 models / 26,464 rows with zero mismatches (row counts,
// exact ID sets, field equality, DateTime equality, deterministic
// fingerprints, and all 9 declared relations all PASS - see
// scripts/reconcile-postgres-snapshot.ts and its run report). This file is
// now what apps/trend-dashboard actually runs against via DATABASE_URL - it
// is NOT a rehearsal/verification artifact.
//
// History: this project ran on SQLite (prisma/dev.db) through the
// SQLite->Postgres migration rehearsal. prisma/schema.postgres.prisma (the
// rehearsal's verification-only schema, pointed at a disposable
// POSTGRES_VERIFICATION_URL Neon database) has since been retired - its
// models are reproduced here verbatim, so keeping both around any longer
// would only create duplicate-schema drift risk. It remains recoverable
// from git history if the rehearsal's exact former setup is ever needed
// again.
//
// prisma/schema.sqlite-export.prisma is a SEPARATE, narrowly-scoped file
// that still targets SQLite - it exists ONLY so
// scripts/export-sqlite-snapshot.ts can keep reading prisma/dev.db (the
// final authoritative SQLite source) for the Phase 2 production data
// migration, now that this canonical schema/client no longer speaks SQLite
// at all. It is never used by the application runtime or by any collector.
//
// Every DateTime field carries an explicit @db.Timestamptz(3): Prisma's
// PostgreSQL default for a bare DateTime field is TIMESTAMP(3) (no
// timezone) - a naive wall-clock value with no stored offset, which only
// round-trips correctly if every writer/reader implicitly agrees the value
// means UTC. TIMESTAMPTZ(3) stores/returns the instant itself, independent
// of server/session timezone, which is required for exact JS Date
// millisecond round-trip and cloud/host-timezone independence. This was
// verified empirically during the rehearsal (`prisma migrate diff
// --from-empty --to-schema-datamodel`) and is carried over unchanged here.
//
// All 16 models are preserved exactly as rehearsed (same fields, types,
// relations, unique/index constraints) - no model was added, removed, or
// restructured as part of this promotion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String            @id @default(cuid())
  externalId       String            @unique
  source           String            @default("musinsa")
  brand            String
  name             String
  url              String
  imageUrl         String?
  category         String
  gender           String?
  color            String?
  isNew            Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  rankingSnapshots RankingSnapshot[]
  tag              ProductTag?

  @@index([brand])
  @@index([category])
  @@index([source])
}

model RankingSnapshot {
  id           String   @id @default(cuid())
  productId    String
  rank         Int
  price        Int?
  salePrice    Int?
  discountRate Int?
  reviewCount  Int?
  likeCount    Int?
  isSoldOut    Boolean  @default(false)
  collectedAt  DateTime @db.Timestamptz(3)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, collectedAt])
  @@index([rank])
  @@index([collectedAt])
}

model CollectionRun {
  id           String    @id @default(cuid())
  source       String
  mode         String
  startedAt    DateTime  @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  status       String
  productCount Int       @default(0)
  fetchedCount Int       @default(0)
  errorCount   Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  errors       CollectionError[]

  @@index([source])
  @@index([startedAt])
  @@index([status])
}

model CollectionError {
  id              String        @id @default(cuid())
  collectionRunId String
  source          String
  externalId      String?
  url             String?
  reason          String
  timestamp       DateTime      @default(now()) @db.Timestamptz(3)
  collectionRun   CollectionRun @relation(fields: [collectionRunId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([timestamp])
}

model TrendKeyword {
  id        String                 @id @default(cuid())
  name      String                 @unique
  category  String
  aliases   String
  shoppingKeyword String?
  naverShoppingCategory String?
  // Specific-item taxonomy linkage for DEMAND SIGNAL (see src/config/taxonomy.ts).
  // Nullable: not every legacy keyword maps cleanly to one SPECIFIC_ITEM yet.
  specificItem   String?
  // PLANNING gender ("UNISEX" | "WOMEN") - which product-planning area this
  // keyword/item belongs to. This is NOT the NAVER shopper gender (see the
  // snapshot models' `gender` field) and must never be conflated with it.
  planningGender String?
  active    Boolean                @default(true)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)
  snapshots KeywordTrendSnapshot[]
  shoppingAgeSnapshots KeywordShoppingAgeSnapshot[]

  @@index([category])
  @@index([active])
  @@index([specificItem])
  @@index([planningGender])
}

model KeywordTrendSnapshot {
  id          String       @id @default(cuid())
  keywordId   String
  source      String
  ageGroup    String
  // NAVER shopper gender ("ALL" | "FEMALE" | "MALE") - who searched, never
  // the product's planning gender.
  gender      String       @default("ALL")
  period      DateTime     @db.Timestamptz(3)
  ratio       Float
  // "real" only for actual NAVER API responses; "mock" for locally generated
  // demo data. Must never be mixed when reading REAL demand data.
  dataMode    String       @default("mock")
  collectedAt DateTime     @db.Timestamptz(3)
  keyword     TrendKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, source, ageGroup, gender, period])
  @@index([source])
  @@index([ageGroup])
  @@index([period])
  @@index([collectedAt])
  @@index([dataMode])
}

model KeywordShoppingAgeSnapshot {
  id          String       @id @default(cuid())
  keywordId   String
  source      String
  ageGroup    String
  // NAVER shopper gender ("ALL" | "FEMALE" | "MALE") - who searched/clicked,
  // never the product's planning gender.
  gender      String       @default("ALL")
  period      DateTime     @db.Timestamptz(3)
  ratio       Float
  // "real" only for actual NAVER API responses; "mock" for locally generated
  // demo data. Must never be mixed when reading REAL demand data.
  dataMode    String       @default("mock")
  collectedAt DateTime     @db.Timestamptz(3)
  keyword     TrendKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, source, ageGroup, gender, period])
  @@index([source])
  @@index([ageGroup])
  @@index([period])
  @@index([collectedAt])
  @@index([dataMode])
}

model ProductTag {
  id          String   @id @default(cuid())
  productId   String   @unique
  itemType    String?
  fit         String?
  mainColor   String?
  subColor    String?
  material    String?
  graphicType String?
  detail      String?
  style       String?
  gender      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InternalProduct {
  id                String          @id @default(cuid())
  externalProductId String?
  productCode       String          @unique
  productName       String
  brand             String?
  category          String?
  season            String?
  gender            String?
  imageUrl          String?
  itemType          String?
  subItemType       String?
  fit               String?
  mainColor         String?
  subColor          String?
  material          String?
  graphicType       String?
  detail            String?
  style             String?
  dataMode          String          @default("sample")
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  salesSnapshots    SalesSnapshot[]

  @@index([brand])
  @@index([category])
  @@index([itemType])
  @@index([subItemType])
  @@index([dataMode])
}

model SalesSnapshot {
  id               String          @id @default(cuid())
  productId        String
  periodDate       DateTime        @db.Timestamptz(3)
  salesQty         Int?
  salesAmount      Int?
  stockQty         Int?
  orderQty         Int?
  sellThroughRate  Float?
  discountRate     Float?
  normalSalesRate  Float?
  storeSalesQty    Int?
  onlineSalesQty   Int?
  dataMode         String          @default("sample")
  importRunId      String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  product          InternalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, periodDate])
  @@index([periodDate])
  @@index([dataMode])
}

model MarketProduct {
  id               String                  @id @default(cuid())
  source           String
  externalProductId String
  brand            String
  name             String
  category         String?
  url              String?
  imageUrl         String?
  itemType         String?
  subItemType      String?
  fit              String?
  mainColor        String?
  subColor         String?
  material         String?
  graphicType      String?
  detail           String?
  style            String?
  gender           String?
  dataMode         String                  @default("sample")
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  rankingSnapshots MarketRankingSnapshot[]

  @@unique([source, externalProductId])
  @@index([source])
  @@index([category])
  @@index([itemType])
  @@index([subItemType])
  @@index([dataMode])
}

model MarketRankingSnapshot {
  id              String        @id @default(cuid())
  marketProductId String
  source          String
  periodDate      DateTime      @db.Timestamptz(3)
  rankingCategory String        @default("ALL")
  observedCategory String        @default("ALL")
  audienceSegment String        @default("ALL")
  metricType      String        @default("UNKNOWN")
  rankingVerified Boolean       @default(false)
  rankingScope    String        @default("UNKNOWN")
  sourcePosition  Int?
  rank            Int?
  price           Int?
  salePrice       Int?
  discountRate    Int?
  reviewCount     Int?
  likeCount       Int?
  dataMode        String        @default("sample")
  importRunId     String?
  rawData         String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  marketProduct   MarketProduct @relation(fields: [marketProductId], references: [id], onDelete: Cascade)

  @@unique([marketProductId, source, periodDate, rankingScope, rankingCategory, observedCategory, audienceSegment])
  @@index([source])
  @@index([rankingCategory])
  @@index([observedCategory])
  @@index([audienceSegment])
  @@index([metricType])
  @@index([rankingVerified])
  @@index([rankingScope])
  @@index([rank])
  @@index([sourcePosition])
  @@index([periodDate])
  @@index([dataMode])
}

model EditorialPost {
  id              String              @id @default(cuid())
  source          String
  externalPostId  String
  url             String
  canonicalUrl    String?
  title           String
  publishedAt     DateTime?           @db.Timestamptz(3)
  imageUrl        String?
  excerpt         String?
  text            String?
  audienceGender  String              @default("UNKNOWN")
  fashionRelevance String             @default("UNKNOWN")
  dataMode        String              @default("sample")
  collectedAt     DateTime            @default(now()) @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  mentions        EditorialMention[]
  contentBlocks   EditorialContentBlock[]

  @@unique([source, externalPostId])
  @@index([source])
  @@index([publishedAt])
  @@index([audienceGender])
  @@index([fashionRelevance])
  @@index([dataMode])
}

model EditorialMention {
  id         String        @id @default(cuid())
  postId     String
  type       String
  value      String
  audienceGender String      @default("UNKNOWN")
  confidence Float         @default(1)
  evidence   String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  post       EditorialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, type, value])
  @@index([type])
  @@index([value])
  @@index([audienceGender])
  @@index([confidence])
}

model EditorialContentBlock {
  id            String        @id @default(cuid())
  postId        String
  blockIndex    Int
  blockType     String
  text          String?
  imageUrl      String?
  caption       String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  post          EditorialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, blockIndex])
  @@index([postId])
  @@index([blockType])
}

model ImportRun {
  id           String        @id @default(cuid())
  type         String
  source       String
  fileName     String?
  rankingCategory String?
  audienceSegment String?
  dataMode     String        @default("sample")
  startedAt    DateTime      @db.Timestamptz(3)
  completedAt  DateTime?     @db.Timestamptz(3)
  status       String
  totalRows    Int           @default(0)
  fetchedRows  Int           @default(0)
  successRows  Int           @default(0)
  failedRows   Int           @default(0)
  skippedRows  Int           @default(0)
  errorMessage String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  errors       ImportError[]

  @@index([type])
  @@index([source])
  @@index([rankingCategory])
  @@index([status])
  @@index([startedAt])
  @@index([dataMode])
}

// WATCHLIST SNAPSHOT (2026-09-21, Phase 6A - Archive foundation).
//
// Home `/` Watchlist evidence is partly mutable: EditorialPost.text can be
// replaced and EditorialMention rows can be deleted/recreated during
// reparsing/recollection (see docs/EDITORIAL_REFRESH_OPERATIONS.md), and
// getAttributeBundles() (src/services/attribute-bundle-service.ts) derives
// bundles from that text ON DEMAND at request time - it is never persisted.
// A future Archive therefore cannot reconstruct "what the Watchlist showed
// on date X" from today's EditorialPost/EditorialMention rows alone. These
// two models are an APPEND-ONLY, point-in-time capture of the Watchlist's
// already-RESOLVED output (see src/services/watchlist-snapshot-service.ts),
// independent of whatever the mutable source evidence looks like later.
//
// Append-only policy: rows are only ever created, never updated or deleted
// by application code (see captureWatchlistSnapshot in
// watchlist-snapshot-service.ts, which only calls prisma...create). Running
// the capture twice on the same businessDate creates a SECOND, distinct
// WatchlistSnapshot row (no unique constraint on businessDate) - "latest for
// a date" is a read-time MAX(capturedAt) selection (see
// selectLatestSnapshotForDate), never an upsert/overwrite.
//
// This is the snapshot FOUNDATION only - no Archive UI, no production writes,
// and no backfilled/invented historical data yet. See the task history for
// "Phase 6A".
model WatchlistSnapshot {
  id          String   @id @default(cuid())
  // Absolute instant the resolver ran (server `now()`), distinct from
  // `createdAt` (Prisma row-insert bookkeeping) the same way EditorialPost
  // already separates `collectedAt` from `createdAt`.
  capturedAt  DateTime @db.Timestamptz(3)
  // "YYYY-MM-DD" as observed in Asia/Seoul (businessDayKey() in
  // src/lib/business-time.ts) - the canonical grouping/lookup key for a
  // future Archive-by-date view. Never derived from a UTC calendar day.
  businessDate String
  // Explicit, deliberately-bumped provenance string (see
  // WATCHLIST_ALGORITHM_VERSION in src/services/watchlist-selection.ts) -
  // never derived from an unstable runtime value (git SHA, package version).
  algorithmVersion String
  // Input scope/filter identity - the exact getAttributeBundles(dataMode,
  // gender) call this snapshot resolved against. Scope is never wider than
  // this: the home page's `scope` (domestic/overseas) query param does not
  // affect the Watchlist section at all (see src/app/page.tsx).
  dataMode    String
  gender      String
  // Source/evidence freshness context needed to understand the snapshot
  // without re-querying mutable EditorialPost rows: how many
  // FASHION_RELEVANT posts (matching dataMode/gender) fed this resolution,
  // and the most recent publishedAt among them.
  sourceEditorialPostCount Int
  sourceLatestPublishedAt DateTime? @db.Timestamptz(3)
  // "scheduled" (future cron) or "manual" (operator-triggered CLI run) -
  // provenance only, never used to filter/exclude a snapshot from Archive.
  triggeredBy String  @default("manual")
  // Denormalized count of `items` - cheap for a future Archive list view
  // without a join/count query.
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  items       WatchlistSnapshotItem[]

  @@index([businessDate])
  @@index([dataMode])
  @@index([gender])
  @@index([capturedAt])
}

model WatchlistSnapshotItem {
  id         String            @id @default(cuid())
  snapshotId String
  // 1-based Watchlist position at capture time (1..N, matches the row order
  // src/components/AttributeBundle.tsx's WatchlistRow rendered).
  rank       Int
  // AttributeBundle.key (specificItem#TYPE:VALUE+...) - a provenance pointer
  // for cross-reference only. Never relied on for reconstruction: the bundle
  // this key currently resolves to may look different later (or vanish) as
  // source evidence changes - every field a future Archive view needs is
  // persisted directly on this row instead.
  bundleKey  String
  specificItem String
  // The exact Korean-first name the UI showed for this row (WatchlistRow /
  // SelectedSignalDetail both use buildSignalInterpretation(bundle).signalName,
  // not the raw bundle.displayName - see src/lib/signal-interpretation.ts).
  signalName String
  displayName String
  // JSON-encoded BundleAttribute[] ({type, value, articlePresence,
  // sourceSpread}) - resolved attribute chips, stored as a string per this
  // schema's existing convention (see MarketRankingSnapshot.rawData) rather
  // than Prisma's Json type, which this schema never otherwise uses.
  directAttributes String
  // bundleEvidenceStrength(...) output, e.g. "반복 관측 · 서로 다른 사례".
  evidenceStrength String
  bundleArticlePresence Int
  bundleSourceSpread    Int
  independentEvidenceClusterCount Int
  publisherFamilySpread Int
  latestObservedAt DateTime? @db.Timestamptz(3)
  // buildSignalInterpretation(bundle) output, persisted verbatim.
  observedFact     String
  // JSON-encoded string[].
  unknowns         String
  planningQuestion String
  // Whether this row was the featured/default-selected signal (the
  // independentEvidenceClusterCount >= 2 pick) at capture time.
  isPrimarySignal  Boolean @default(false)
  // Always "NOT_COMPARABLE" today - bundles have no comparable "최근 방향" at
  // this exact-bundle grain (see LeadSignalDimensions in
  // AttributeBundle.tsx: "조합 단위 비교값 없음"). An explicit, honest
  // constant rather than an invented direction value; a future
  // algorithmVersion may introduce a real comparable status.
  directionStatus String @default("NOT_COMPARABLE")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  snapshot   WatchlistSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, rank])
  @@index([snapshotId])
  @@index([specificItem])
  @@index([bundleKey])
}

model ImportError {
  id          String    @id @default(cuid())
  importRunId String
  rowNumber   Int?
  field       String?
  reason      String
  rawRow      String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([importRunId])
  @@index([createdAt])
}
